# Copy this file to backend/.env and fill in your keys.
# Get paper-trading keys at https://app.alpaca.markets (switch to the Paper account first).
# Keep comments on their own lines: some tools treat text after a value as part of it.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = paper money. Read DEPLOYMENT.md before ever changing this.
ALPACA_PAPER=true
# iex (free) or sip (all exchanges; the free plan allows sip data older than 15 minutes)
ALPACA_DATA_FEED=iex

# What to trade. SPY is the benchmark and a market-context input; it is not traded.
SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOGL,META,JPM,V,UNH,XOM
BENCHMARK=SPY
HISTORY_YEARS=5

# Market conditions (current trends), from trusted public sources:
#  - FRED, the Federal Reserve Bank of St. Louis: VIX, 10-year Treasury yield, yield curve, credit spread
#  - the 11 sector funds (XLK, XLF, ...) through Alpaca
# The model only uses them if they improve its walk-forward test; "train" reports which way it went.
USE_MARKET_CONTEXT=true
# Optional free key from https://fred.stlouisfed.org/docs/api/api_key.html (works without one too)
FRED_API_KEY=
# Which sector fund each stock belongs to, for stocks the bot doesn't already know, e.g. KO:XLP,BA:XLI
SECTORS=

# Model: predict whether a stock gains more than LABEL_THRESHOLD over the next HORIZON_DAYS sessions
HORIZON_DAYS=5
LABEL_THRESHOLD=0.01
N_ESTIMATORS=400
MAX_DEPTH=6
MIN_SAMPLES_LEAF=40
# newest 25% of dates are held out for the out-of-sample test and backtest
TEST_FRACTION=0.25

# Strategy (used identically by the backtest and the live bot)
ENTRY_THRESHOLD=0.58
EXIT_THRESHOLD=0.45
MAX_POSITIONS=5
POSITION_SIZE_PCT=0.18
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.10
MAX_HOLDING_DAYS=10
# no new buys while SPY is below its 50-day average
USE_MARKET_FILTER=true
# News check (Benzinga headlines via Alpaca): skip a new buy when the last NEWS_LOOKBACK_DAYS days
# have at least NEWS_MIN_ARTICLES headlines and their average tone is below NEWS_BLOCK_SCORE (-1..1).
# It never sells anything; it only holds back new buys.
NEWS_CHECK=true
NEWS_LOOKBACK_DAYS=3
NEWS_MIN_ARTICLES=3
NEWS_BLOCK_SCORE=-0.4
MAX_DAILY_LOSS_PCT=0.03
# backtest cost assumption per side, in basis points
SLIPPAGE_BPS=5

# Bot. TRADING_ENABLED=false computes signals but places no orders.
TRADING_ENABLED=true
# Buy and sell buttons in the dashboard. The bot never sells stocks the admin buys by hand.
# On a dashboard other devices can reach, they need user accounts (or DASHBOARD_PASSWORD).
MANUAL_TRADING=true
# New York time, after the close; orders queue for the next open
TRADE_TIME=16:20

# Where accounts and the bot's journal are stored. Empty = SQLite files in backend/data.
# For Supabase: Project > Connect > "Session pooler" connection string, with your database password, e.g.
#   DATABASE_URL=postgresql://postgres.abcdefghijkl:YOUR-DB-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# (not the "Transaction pooler" on port 6543). Then: python -m algotrader db status
DATABASE_URL=
# Docker on a host without a persistent disk: train a fresh model each time the container starts
TRAIN_ON_START=false
# Hosting on Vercel (set in Vercel's Environment Variables, see DEPLOYMENT.md Option D):
#   CRON_SECRET=a long random text   (turns on the daily bot run Vercel triggers)
#   LIVE_STREAM=false and TRUST_PROXY=true are set automatically there

# User accounts: people sign up, log in and buy stocks in their own Alpaca paper account.
# The first account created on this computer becomes the admin (the only one who sees the bot's account).
# Manage accounts with: python -m algotrader users list / make-admin / reset-password / delete
USER_ACCOUNTS=true
# false = nobody new can sign up (existing accounts keep working)
ALLOW_SIGNUPS=true
# Encrypts the Alpaca keys people save. Empty = a random key is created in backend/data/secret.key
# (back that file up: without it everyone has to connect their Alpaca account again).
SECRET_KEY=
# How many days a log-in lasts on one browser
SESSION_DAYS=30

# Dashboard. 127.0.0.1 = only this computer can open it. Use 0.0.0.0 only on a server,
# together with HTTPS (see DEPLOYMENT.md).
API_HOST=127.0.0.1
PORT=8000
# Optional extra password prompt in front of the whole site (not needed with user accounts)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# only needed if the frontend is hosted on a different domain
CORS_ORIGINS=
STREAM_INTERVAL_SECONDS=5
